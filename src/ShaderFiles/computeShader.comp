#version 460 core
layout(local_size_x = 8, local_size_y = 4) in;
layout(r32f, binding = 0) uniform image2D u_cascade1Depth;  // Coarse
layout(r32f, binding = 1) uniform image2D u_cascade2Depth;  // Medium
layout(r32f, binding = 2) uniform image2D u_cascade3Depth;  // Fine
layout(rgba32f, binding = 3) uniform image2D u_output;

// Planet data SSBO
struct PlanetData {
    vec4 positionRadius;  // xyz = position, w = radius
    vec4 colorGravity;    // xyz = color, w = gravity strength
};

layout(std430, binding = 4) readonly buffer PlanetBuffer {
    PlanetData planets[];
};

uniform int u_numPlanets = 0;  // Number of planets

// ──────────────────────────────────────────────────────────────────────── //
//                            VARIABLES & UNIFORMS                          //
// ──────────────────────────────────────────────────────────────────────── //
uniform float   u_maxDist = 50.0f;
uniform float   u_epsilon = 0.01f;
uniform int     u_maxStepsCone = 64;  // Increased from 32 since cascades start fresh
uniform int     u_maxStepsMain = 128;
uniform float   u_coneMultiplier = 1.25;  // Cone step width: increase for wider cone acceptance

uniform ivec2 u_fullRes;
uniform ivec2 u_cascade1Res;    // Coarse grid resolution
uniform ivec2 u_cascade2Res;    // Medium grid resolution
uniform ivec2 u_cascade3Res;    // Fine grid resolution
uniform float u_fov;
uniform float u_time;
uniform int   u_passType;       // 0 = cascade1, 1 = cascade2, 2 = cascade3, 3 = main raymarch
uniform int   u_aaSamples;      // Anti-aliasing: number of samples per pixel side (1 = off, 2 = 2x2 = 4 samples)

// ─────────────────────────── Camera & Output ──────────────────────────── //
uniform vec3  u_camPos;
uniform vec3  u_camRot;
uniform int   u_buffer;     

// ─────────────────────────── Render constants ─────────────────────────── //
const vec3    u_bgColor = vec3(0.05f, 0.05f, 0.1f);

// ─────────────────────────── Stupid Includes  ─────────────────────────── //
#include "hg_sdf.hlsl"
#include "map.hlsl"
#include "materials.hlsl"

// ──────────────────────────────────────────────────────────────────────── //
//                              TYPES & UTILITIES                           //
// ──────────────────────────────────────────────────────────────────────── //

struct Ray {
    vec3 origin;
    vec3 dir;
};

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// ──────────────────────────────────────────────────────────────────────── //
//                             CAMERA & RAY SETUP                           //
// ──────────────────────────────────────────────────────────────────────── //

Ray makePrimaryRay(vec2 fragCoord, vec2 resolution) {
    // Normalize coordinates to [0, 1] and convert to [-1, 1]
    vec2 ndc = (fragCoord / resolution) * 2.0f - 1.0f;
    float aspect = resolution.x / resolution.y;
    ndc.x *= aspect;
    
    // ───────────────────── //
    //    Camera  rotation   //
    // ───────────────────── //
    float pitch = u_camRot.x;
    float yaw = u_camRot.y;

    float cp = cos(pitch);
    float sp = sin(pitch);
    float cy = cos(yaw);
    float sy = sin(yaw);

    mat3 rotX = mat3(
        1.0, 0.0, 0.0,
        0.0, cp, -sp,
        0.0, sp,  cp
    );

    mat3 rotY = mat3(
         cy, 0.0, sy,
         0.0, 1.0, 0.0,
        -sy, 0.0, cy
    );
    // ───────────────────── //
    // ───────────────────── //
    // ───────────────────── //

    vec3 rayDir = normalize(vec3(ndc * u_fov, 1.0));
    vec3 rotatedRayDir  = normalize(rotY * rotX * rayDir);

    Ray r;
    r.origin = u_camPos;
    r.dir    = rotatedRayDir;
    return r;
}

float doConeMarching(Ray ray, float d) {
    float cd;
    float ccr;
    float camTanFov = tan(radians(u_fov / 2));
    for (int i = 0; i < u_maxStepsCone; ++i) {
        vec3 p = ray.origin + d * ray.dir;
        float cd = mapSDF(p).x;
        ccr = (d * camTanFov) * 2.0 / (0.5 * float(u_fullRes.y));

        if(cd < ccr * 1.25 || d >= u_maxDist) break;

        if (cd > 15.0 && i > 8) {
            d = u_maxDist;
            break;
        }

        d += cd;

        if (d > u_maxDist)
            break;
    }

    return d;
}


// ──────────────────────────────────────────────────────────────────────── //
//                             NORMAL & SHADING                             //
// ──────────────────────────────────────────────────────────────────────── //

vec3 calcNormal(vec3 p) {
    const vec2 e = vec2(1.0, -1.0) * 0.001;

    return normalize(
        e.xyy * mapSDF(p + e.xyy).x +
        e.yyx * mapSDF(p + e.yyx).x +
        e.yxy * mapSDF(p + e.yxy).x +
        e.xxx * mapSDF(p + e.xxx).x
    );
}

vec3 getObjectColor(float objIndex) {
    // If object index is 0, it's the fractal - use default red
    if (objIndex < 0.5) {
        return vec3(1.0, 0.0, 0.0);  // Red for fractal
    }
    
    // Otherwise it's a planet - look up its color from SSBO
    int planetIdx = int(objIndex) - 1;
    if (planetIdx >= 0 && planetIdx < u_numPlanets) {
        return planets[planetIdx].colorGravity.xyz;
    }
    
    return vec3(1.0);  // Fallback white
}

vec3 shade(vec3 pos, vec3 n, vec3 rayDir, float objIndex) {
    vec3  lightDir = normalize(vec3(0.3, 0.7, 0.2));
    float diff    = max(dot(n, lightDir), 0.0);
    float spec    = pow(max(dot(reflect(-lightDir, n), -rayDir), 0.0), 32.0);

    // Get color based on object type
    vec3 baseColor = getObjectColor(objIndex);
    
    vec3 col = baseColor * diff + vec3(1.0) * spec * 0.25;
    return col;
}

// ──────────────────────────────────────────────────────────────────────── //
//                          CASCADING CONE PREPASS                          //
//                    Cascade1 → Cascade2 → Cascade3 → Main                 //
// ──────────────────────────────────────────────────────────────────────── //

// Cascade 1: Coarse pass (simple distance marching, no cone angle)
void runCascade1(ivec2 gliID) {
    vec2 pixelsPerCell = vec2(u_fullRes) / vec2(u_cascade1Res);
    vec2 fullResCoord = (vec2(gliID) + vec2(0.5)) * pixelsPerCell;
    
    Ray ray = makePrimaryRay(fullResCoord, vec2(u_fullRes));

    float t = 0.0;
    float safeT = u_maxDist;
    safeT = doConeMarching(ray, t);

    imageStore(u_cascade1Depth, gliID, vec4(safeT));
}

// Cascade 2: Medium pass (simple distance marching, no cone angle)
void runCascade2(ivec2 gliID) {
    vec2 cascade2toCascade1 = vec2(u_cascade1Res) / vec2(u_cascade2Res);
    ivec2 cascade1ID = ivec2(vec2(gliID) * cascade2toCascade1);
    cascade1ID = clamp(cascade1ID, ivec2(0), u_cascade1Res - ivec2(1));

    float cascade1Depth = imageLoad(u_cascade1Depth, cascade1ID).r;
    
    if (cascade1Depth >= u_maxDist - 1e-3) {
        imageStore(u_cascade2Depth, gliID, vec4(u_maxDist));
        return;
    }

    vec2 pixelsPerCell = vec2(u_fullRes) / vec2(u_cascade2Res);
    vec2 fullResCoord = (vec2(gliID) + vec2(0.5)) * pixelsPerCell;
    
    Ray ray = makePrimaryRay(fullResCoord, vec2(u_fullRes));

    float t = max(cascade1Depth - 0.5, 0.0);
    float safeT = u_maxDist;
    safeT = doConeMarching(ray, t);

    imageStore(u_cascade2Depth, gliID, vec4(safeT));
}

// Cascade 3: Fine pass (simple distance marching, no cone angle)
void runCascade3(ivec2 gliID) {
    vec2 cascade3toCascade2 = vec2(u_cascade2Res) / vec2(u_cascade3Res);
    ivec2 cascade2ID = ivec2(vec2(gliID) * cascade3toCascade2);
    cascade2ID = clamp(cascade2ID, ivec2(0), u_cascade2Res - ivec2(1));

    float cascade2Depth = imageLoad(u_cascade2Depth, cascade2ID).r;
    
    if (cascade2Depth >= u_maxDist - 1e-3) {
        imageStore(u_cascade3Depth, gliID, vec4(u_maxDist));
        return;
    }

    vec2 pixelsPerCell = vec2(u_fullRes) / vec2(u_cascade3Res);
    vec2 fullResCoord = (vec2(gliID) + vec2(0.5)) * pixelsPerCell;
    
    Ray ray = makePrimaryRay(fullResCoord, vec2(u_fullRes));

    float t = max(cascade2Depth - 0.5, 0.0);
    float safeT = u_maxDist;
    safeT = doConeMarching(ray, t);

    imageStore(u_cascade3Depth, gliID, vec4(safeT));
}

// ──────────────────────────────────────────────────────────────────────── //
//                               MSAA FUNCTIONS                             //
// ──────────────────────────────────────────────────────────────────────── //

// Pseudo-random number generator for jittered sampling
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

// Get jittered sample offset within pixel
vec2 getJitteredOffset(int sampleIndex, int totalSamples, vec2 pixelCoord) {
    int sqrtSamples = int(sqrt(float(totalSamples)));
    int x = sampleIndex % sqrtSamples;
    int y = sampleIndex / sqrtSamples;
    
    float basePosX = float(x) / float(sqrtSamples);
    float basePosY = float(y) / float(sqrtSamples);
    
    // Add random jitter within sub-pixel
    float jitterX = hash(pixelCoord + vec2(x, y)) / float(sqrtSamples);
    float jitterY = hash(pixelCoord + vec2(y, x + 0.5)) / float(sqrtSamples);
    
    return vec2(basePosX + jitterX, basePosY + jitterY);
}

// ──────────────────────────────────────────────────────────────────────── //
//                          MAIN RAY MARCH (PASS 1)                         //
// ──────────────────────────────────────────────────────────────────────── //

float sampleConeDepthBilinear(ivec2 pixel) {
    // Map full-res pixel to cascade3 grid float coords
    vec2 scale = vec2(u_cascade3Res) / vec2(u_fullRes);
    vec2 gridPos = (vec2(pixel) + vec2(0.5)) * scale - vec2(0.5);

    ivec2 i0 = ivec2(floor(gridPos));
    ivec2 i1 = i0 + ivec2(1, 0);
    ivec2 i2 = i0 + ivec2(0, 1);
    ivec2 i3 = i0 + ivec2(1, 1);

    vec2 f = fract(gridPos);

    i0 = clamp(i0, ivec2(0), u_cascade3Res - ivec2(1));
    i1 = clamp(i1, ivec2(0), u_cascade3Res - ivec2(1));
    i2 = clamp(i2, ivec2(0), u_cascade3Res - ivec2(1));
    i3 = clamp(i3, ivec2(0), u_cascade3Res - ivec2(1));

    float d00 = imageLoad(u_cascade3Depth, i0).r;
    float d10 = imageLoad(u_cascade3Depth, i1).r;
    float d01 = imageLoad(u_cascade3Depth, i2).r;
    float d11 = imageLoad(u_cascade3Depth, i3).r;

    float dx0 = mix(d00, d10, f.x);
    float dx1 = mix(d01, d11, f.x);
    float d   = mix(dx0, dx1, f.y);

    return d;
}

void runMainRaymarch(ivec2 gliID) {
    vec4 accumulatedColor = vec4(0.0);
    int totalSamples = u_aaSamples * u_aaSamples;
    
    // For debug visualization, track stats from center sample
    vec3 debugHitPos = vec3(0.0);
    int debugStepCount = 0;
    float debugMinDistance = u_maxDist;
    bool debugHit = false;
    
    for (int sampleIdx = 0; sampleIdx < totalSamples; ++sampleIdx) {
        // Get jittered sub-pixel offset for this sample
        vec2 jitterOffset = getJitteredOffset(sampleIdx, totalSamples, vec2(gliID));
        vec2 samplePixel = vec2(gliID) + jitterOffset;
        
        Ray ray = makePrimaryRay(samplePixel, u_fullRes);
        float tCone = sampleConeDepthBilinear(ivec2(samplePixel));

        // If cone pass didn't hit anything, skip this sample
        if (tCone >= u_maxDist - 1e-3) {
            accumulatedColor += vec4(u_bgColor, 1.0);
            continue;
        }

        // Start a bit *before* cone depth to be safe
        float t = max(tCone - 1.0, 0.0);

        bool hit = false;
        vec3 hitPos = vec3(0.0);
        int stepCount = 0;
        float minDistance = u_maxDist;
        
        // Adaptive iteration reduction for close-up optimization
        int maxSteps = u_maxStepsMain;
        if (tCone < 5.0) maxSteps = 80;
        else if (tCone < 15.0) maxSteps = 100;

        float objectIndex = 0.0;  // Track which object was hit
        
        for (int i = 0; i < maxSteps; ++i) {
            hitPos = ray.origin + t * ray.dir;
            vec2 mapResult = mapSDF(hitPos);
            float d = mapResult.x;
            objectIndex = mapResult.y;  // Capture object index
            
            minDistance = min(minDistance, d);
            stepCount = i;

            if (d < u_epsilon) {
                hit = true;
                break;
            }

            if (d > 15.0 && i > 10) {
                break;
            }

            t += d;
            if (t > u_maxDist)
                break;
        }

        vec4 sampleCol = vec4(u_bgColor, 1.0);

        if (hit) {
            vec3 n   = calcNormal(hitPos);
            vec3 col = shade(hitPos, n, ray.dir, objectIndex);
            sampleCol = vec4(col, 1.0);
        }

        accumulatedColor += sampleCol;
        
        // Store debug info from first (center) sample
        if (sampleIdx == 0) {
            debugHitPos = hitPos;
            debugStepCount = stepCount;
            debugMinDistance = minDistance;
            debugHit = hit;
        }
    }
    
    // Average the accumulated samples
    vec4 outCol = accumulatedColor / float(totalSamples);

    // ───────────────────────────────────────────────────────────────────────────── //
    // ─────────────────────────── DISPLAY DEBUG BUFFERS ─────────────────────────── //
    // ───────────────────────────────────────────────────────────────────────────── //

    switch(u_buffer)
    {
        case 0:
            // Visualize final color
            outCol = outCol;
            break;
        
        case 1:
            // Visualize normals
            if (debugHit) {
                outCol = vec4(calcNormal(debugHitPos), 1.0);
            }
            break;

        case 2:
            // Visualize step count
            outCol = vec4(vec3(float(debugStepCount) / float(u_maxStepsMain)), 1.0);
            break;

        case 3:
            // Visualize cascade depth
            outCol = vec4(0.0);
            // Check cascade 1
            float depthLoaded = imageLoad(u_cascade1Depth, ivec2(vec2(gliID) * vec2(u_cascade1Res) / vec2(u_fullRes))).r;
            if(depthLoaded >= u_maxDist - 1e-3) outCol += vec4(0.2, 0.0, 0.0, 1.0);
            else outCol                                += vec4(0.0, 0.2, 0.0, 1.0);
            
            depthLoaded = 0.0;
            // Check cascade 2
            depthLoaded = imageLoad(u_cascade2Depth, ivec2(vec2(gliID) * vec2(u_cascade2Res) / vec2(u_fullRes))).r;
            if(depthLoaded >= u_maxDist - 1e-3) outCol += vec4(0.2, 0.0, 0.0, 1.0);
            else outCol                                += vec4(0.0, 0.2, 0.0, 1.0);

            depthLoaded = 0.0;
            // Check cascade 3   
            depthLoaded = imageLoad(u_cascade3Depth, ivec2(vec2(gliID) * vec2(u_cascade3Res) / vec2(u_fullRes))).r;
            if(depthLoaded >= u_maxDist - 1e-3) outCol += vec4(0.2, 0.0, 0.0, 1.0);
            else outCol                                += vec4(0.0, 0.2, 0.0, 1.0);

            break;
        case 4:
            // Visualize minimum distance to surface (for misses)
            outCol = vec4(vec3(clamp(debugMinDistance / 1.0, 0.0, 1.0)), 1.0);
            break;

    }

    imageStore(u_output, gliID, outCol);

    // ───────────────────────────────────────────────────────────────────────────── //
    // ───────────────────────────────────────────────────────────────────────────── //
    // ───────────────────────────────────────────────────────────────────────────── //

}

// ──────────────────────────────────────────────────────────────────────── //
//                             MAIN ENTRY OUTPUT                            //
// ──────────────────────────────────────────────────────────────────────── //

void main() {
    ivec2 gliID = ivec2(gl_GlobalInvocationID.xy);

    if (u_passType == 0) {
        if (gliID.x < u_cascade1Res.x && gliID.y < u_cascade1Res.y) {
            runCascade1(gliID);
        }
    } 
    else if (u_passType == 1) {
        if (gliID.x < u_cascade2Res.x && gliID.y < u_cascade2Res.y) {
            runCascade2(gliID);
        }
    }
    else if (u_passType == 2) {
        if (gliID.x < u_cascade3Res.x && gliID.y < u_cascade3Res.y) {
            runCascade3(gliID);
        }
    }
    else if (u_passType == 3) {
        if (gliID.x < u_fullRes.x && gliID.y < u_fullRes.y) {
            runMainRaymarch(gliID);
        }
    }
}
